[TEMPLATE]
# Local development (NODE_ENV=development loads this `.env` file)
NODE_ENV=development
PORT=3000
# Supabase Dashboard -> Connect -> Session pooler connection string.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
JWT_SECRET=replace-me-with-a-secret-at-least-16-chars
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
ALLOWED_ORIGINS=http://localhost:5173
# Production: Brevo HTTPS works on hosts that block SMTP.
# Create an API key (not an SMTP key) and verify MAIL_FROM in Brevo.
# Keep keys in backend environment variables, never frontend VITE_* variables.
# auto selects Brevo, then SMTP when credentials are present.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
# Local development email via SMTP (Gmail).
# Leave SMTP_USER/SMTP_PASS empty to stub-log emails instead of sending them.
# Gmail requires an App Password, not your normal account password:
# Google Account -> Security -> 2-Step Verification -> App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-address@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM=Paws&Homes <your-smtp-address@gmail.com>
APP_URL=http://localhost:5173
# Platform admin seeded on boot (development default: admin/password123).
# ADMIN_EMAIL=admin@pawsandhomes.ph
# ADMIN_PASSWORD=password123

# ---------------------------------------------------------------------------
# Production on Supabase
# Set DATABASE_URL in Render Environment using the Supabase session pooler connection URL.
# Migrations automatically use the configured Supabase endpoint.
# Existing Supabase records are not transferred by changing this connection.
# ADMIN_EMAIL=you@your-domain
# ADMIN_PASSWORD=your-strong-production-password

