# Local development
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pet_adoption
JWT_SECRET=replace-me-with-a-secret-at-least-16-chars
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
ALLOWED_ORIGINS=http://localhost:5173
# Transactional email via SMTP (Gmail).
# Leave SMTP_USER/SMTP_PASS empty to stub-log emails instead of sending them.
# Gmail requires an App Password, not your normal account password:
# Google Account -> Security -> 2-Step Verification -> App passwords.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# MAIL_FROM=Paws&Homes <you@gmail.com>
# APP_URL=http://localhost:5173
