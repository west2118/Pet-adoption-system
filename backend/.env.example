[TEMPLATE]
# Local development (NODE_ENV=development loads this `.env` file)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pet_adoption
JWT_SECRET=replace-me-with-a-secret-at-least-16-chars
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
ALLOWED_ORIGINS=http://localhost:5173
# Transactional email via SMTP (Gmail).
# Leave SMTP_USER/SMTP_PASS empty to stub-log emails instead of sending them.
# Gmail requires an App Password, not your normal account password:
# Google Account -> Security -> 2-Step Verification -> App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-address@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM=Paws&Homes <your-smtp-address@gmail.com>
APP_URL=http://localhost:5173
# Platform admin seeded on boot (development default: admin/password123).
# ADMIN_EMAIL=admin@pawsandhomes.ph
# ADMIN_PASSWORD=password123

# ---------------------------------------------------------------------------
# Production on Supabase (NODE_ENV=production loads `.env.production`)
#
# 1. Supabase Dashboard -> Project Settings -> Database -> Connection string.
# 2. Pick "Session pooler" (IPv4-compatible) and copy the URI.
# 3. Replace [YOUR-PASSWORD] with the database password from the same panel.
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# TLS is applied automatically for *.supabase.co / *.pooler.supabase.com hosts.
# `npm run migrate` skips CREATE DATABASE on managed providers and applies
# every file in backend/migrations inside one transaction each. Adding a new
# .sql file there is all that is needed — the server also migrates on boot.
#
# JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
# ALLOWED_ORIGINS=https://your-frontend-domain
# APP_URL=https://your-frontend-domain
# ADMIN_EMAIL=you@your-domain
# ADMIN_PASSWORD=<strong password — required in production>
#
# NOTE: the frontend never connects to Postgres directly. It calls the Express
# API (VITE_API_URL); the VITE_SUPABASE_* values belong in my-project/.env*.
# ---------------------------------------------------------------------------
