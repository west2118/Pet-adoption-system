# Production frontend build (`npm run build`).
#
# The app reads and writes all data through the Express API, so this must point
# at the deployed backend (include the /api/v1 suffix):
# VITE_API_URL=https://your-backend-domain/api/v1

# Supabase public project settings. Safe to ship in the bundle (the publishable
# key is the browser-side "anon" key). Reserved for Supabase Storage uploads —
# the Postgres database itself is only reached by the backend.
VITE_SUPABASE_URL=https://wbwlnrtjwxbugctexqwm.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_vfvprYNosbUEVtbjkAewlw_w-JqqzaI
